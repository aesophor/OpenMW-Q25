+    void ActorAnimation::setHolsteredShieldOffset(const osg::Vec3f& offset)
+    {
+        mHolsteredShieldOffset = offset;
+        applyHolsteredShieldOffset();
+    }
+
+    void ActorAnimation::applyHolsteredShieldOffset()
+    {
+        // The skeleton can be rebuilt, so remember the original translation per bone instance.
+        auto* bone = dynamic_cast<osg::MatrixTransform*>(getBoneByName("Bip01 AttachShield"));
+        if (!bone)
+            return;
+
+        if (mHolsteredShieldBone.get() != bone)
+        {
+            mHolsteredShieldBone = bone;
+            mHolsteredShieldBoneTranslation = bone->getMatrix().getTrans();
+        }
+
+        const osg::Vec3f translation = mHolsteredShieldBoneTranslation + mHolsteredShieldOffset;
+        if (auto* nifBone = dynamic_cast<NifOsg::MatrixTransform*>(bone))
+            nifBone->setTranslation(translation);
+        else
+        {
+            osg::Matrix matrix = bone->getMatrix();
+            matrix.setTrans(translation);
+            bone->setMatrix(matrix);
+        }
+    }
