+void WindowBase::fillScreenForController(bool active, int maxHeight, bool centerInView)
+{
+    MyGUI::IntSize viewSize = MyGUI::RenderManager::getInstance().getViewSize();
+    const int menuHeight = MWBase::Environment::get().getWindowManager()->getControllerMenuHeight();
+    int width = std::min(viewSize.width, 1600);
+    int height = std::min(menuHeight, maxHeight);
+    int x = (viewSize.width - width) / 2;
+    int y = ((centerInView ? viewSize.height : menuHeight) - height) / 2;
+
+    MyGUI::Window* window = mMainWidget->castType<MyGUI::Window>();
+    window->setCoord(x, active ? y : viewSize.height + 1, width, height);
+}
